# Keep repository text deterministic across Windows, macOS, Linux, and Godot.
* text=auto eol=lf

# Godot text formats and generated import metadata.
*.cs text eol=lf
*.gd text eol=lf
*.gdshader text eol=lf
*.godot text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.theme text eol=lf
*.uid text eol=lf
*.import text eol=lf

# Project documentation and configuration.
*.cfg text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# -----------------------------------------------------------------------------
# Art assets: keep binary/heavy authoring and runtime assets in Git LFS.
# Small text-native formats such as SVG, Godot scenes/resources and import
# metadata intentionally remain normal Git files so they stay diffable.
# -----------------------------------------------------------------------------

# 3D models / interchange / DCC source files.
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
