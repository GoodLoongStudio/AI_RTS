.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# .NET build outputs
**/bin/
**/obj/

# Local regression logs
.test-results/

# Godot runtime logs (mapped user-data dir inside repo) — never commit
Godot/app_userdata/

.DS_Store
addons/godot_ai/
*.bundle

# Python
__pycache__/
*.pyc

# Mapgen local runtime
tools/mapgen/.venv-g2/
tools/mapgen/workbench_output/
tools/mapgen/runs/*/G2/
tools/mapgen/runs/*/G3/
tools/mapgen/runs/*/G4/
tools/mapgen/runs/*_summary/
tools/mapgen/runs/assets/
tools/mapgen/runs/_test_determinism/
tools/mapgen/runs_512/
engine.local.json
**/engine.local.json

# Commercial / huge source pack — play via assets/models/scifi-worlds
初选素材包/

# 系统 UI 取证截图（本地产物，勿提交）
tmp_ui_shots/
服务器信息.md

# 2026-09-20 瘦身：临时诊断产物 / 本机缓存不再跟踪
tmp_logs/
Godot/shader_cache/

# 导出产物（体积大，绝不入库；保留 .gdignore 让 Godot 跳过该目录）
build/*
!build/.gdignore
