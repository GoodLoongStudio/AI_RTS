# 本机完整副官配置（2026-09-21 混合架构定版）
# 依据：docs/程序文档/AI副官_Laya混合架构_执行提示词_2026-09-20.md
#
# 默认架构（三层，全部本地，无云端依赖——参赛打包版同此配置）：
# - 规则层（behavior_tree + rules_fallback）：每 tick 常驻，执行与地板兜底；
# - System 1 选择层：**Laya**（进程内判别式引擎，`AIRTS_S1_BACKEND=laya`），
#   失败自动回退 2B（同一份候选表 + 同一套校验）；
# - System 2 生成层：**本机 2B**（Ollama `minicpm5-adj-16k`，战略层默认开，
#   30s/次；`--strategy-mode off` 可关）。
# - Hermes 已移除（2026-09-21，用户决定：暂时不需要）。
#
# 设计要点：
# - **单模型**：战略与战术回退都指向同一个本地 2B，不分层各配一个（方案 §1/§3）。
# - **直连 Ollama**：不依赖旧自制代理、不走隧道、不出公网（方案 §3「不依赖旧自制代理」）。
# - 全本地：Ollama（2B）+ laya 进程内模型；断网/缺模型时逐级降级，不影响对局进行。

# ---- 全局（runner 启动前的 Provider 可用性检查会读这两项）----
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=minicpm5-adj-16k
LLM_API_KEY=local-no-auth

# ---- 战术（实时决策链）----
TACTICS_BASE_URL=http://127.0.0.1:11434/v1
TACTICS_MODEL=minicpm5-adj-16k
TACTICS_API_KEY_ENV=TACTICS_API_KEY
TACTICS_API_KEY=local-no-auth

# ---- 战略（同一模型、同一条链，不构成第二个决策模型）----
STRATEGY_BASE_URL=http://127.0.0.1:11434/v1
STRATEGY_MODEL=minicpm5-adj-16k
STRATEGY_API_KEY_ENV=TACTICS_API_KEY

# ---- 超时（2026-09-11 修正：不要再用 4s 卡 LLM）----
# 架构分工：**微操（单位级即时反应）归行为树/规则层**，LLM 只负责"意图"层。
# runner 是按 `tactics_interval_ticks` / `strategy_interval_ticks` 节流的异步循环，
# 模型慢**不会**阻塞指挥链——单位由规则/行为树继续驱动。因此把 LLM 掐在 4s
# 属于自伤：真实对局上下文（49 单位+14 资源+事件）下 2B 模型必然答不完，
# 实测降级日志 60x/36x 全是 ModelTimeout，最终只剩规则兜底 → 表现为"只会造兵"。
# 放宽后 LLM 才有机会真正接上；真超时也只是降级，不影响微操。
LLM_TIMEOUT_SECONDS=25
# 战略层是**同步**调用（不走异步调度器），超时会直接占用主循环：间隔 1800 tick≈30s
# 一次，15s 上限仍远大于 2B 实测（0.5~2.4s/次）；真机对照见验证报告 §4。
STRATEGY_TIMEOUT_SECONDS=15

# ---- System 1：Laya 判别式决策引擎（2026-09-21 起默认启用）----
# 取值：laya=判别式引擎（默认）｜model=回退到 2B 实时链路｜off=两层都关（纯规则）。
# 启用条件：副官 venv 已 `pip install laya`（torch/transformers 会一并装上），
# 模型已下载（multilingual 647MB，HF 缓存或随包分发）；任何失败都会自动回退 2B。
AIRTS_S1_BACKEND=laya
# 多语言版（中文字段必须；英文 base 对中文会"自信地错"）。
AIRTS_LAYA_MODEL=convaiinnovations/laya
AIRTS_LAYA_SUBFOLDER=multilingual
# 留空=自动选择（cuda→mps→cpu）。
AIRTS_LAYA_DEVICE=
# 单次调用超时（P0 实测 RTX 3080 Ti 一次前向 p50 47~63ms；2 秒已是 15 倍余量）。
AIRTS_LAYA_TIMEOUT_SECONDS=2
# 少样本示例库（P0 实测：零样本一致率 0%，必须带项目自己的历史决策样例）。
# 由 deploy/build_laya_demos.py 从真实对局日志生成；留空=零样本（仅作对照）。
AIRTS_LAYA_DEMOS=G:\AIRTS\AI_RTS\source\adjutant_coordinator\graph\laya_demos.jsonl
# 默认交火改用"移动并攻击"走向目标（用户 2026-09-21：副官不要每次只点兵）；
# 途中遇敌就地交火、击杀后继续推进。设为 0 回退到点攻击口径。
AIRTS_ENGAGE_ATTACK_MOVE=1
# ---- Laya 健康熔断（2026-09-21）----
# 单次超时（上面 AIRTS_LAYA_TIMEOUT_SECONDS）只让"这一拍"回退 2B；若 Laya 持续
# 不健康（弱 GPU/重争用下每拍都超时或输出全被拒），熔断器按最近窗口失败率直接
# 断开——不再每拍白等 2s，冷却后半开试探，探成功即恢复。
# 1=开（默认）/ 0=关；窗口 10 次、失败率>50% 断开、冷却 60s 起每次连续断开翻倍。
AIRTS_LAYA_CIRCUIT=1
AIRTS_LAYA_CIRCUIT_WINDOW=10
AIRTS_LAYA_CIRCUIT_MAX_FAIL_RATE=0.5
AIRTS_LAYA_CIRCUIT_COOLDOWN_S=60
